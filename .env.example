# Copy to .env.local (for local development) and fill in.
# On Vercel, add the same names under Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon public" key, or the newer "Publishable key" (sb_publishable_...).
# NEVER put the service_role / secret key anywhere in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional (defaults shown)
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_LOCALE=en-IN
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
